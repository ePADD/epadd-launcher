<?xml version="1.0" encoding="UTF-8"?>
<project name="epadd" default="release" basedir="." xmlns:artifact="antlib:org.apache.maven.artifact.ant">

	<description>
        ePADD Standalone application build script
    </description>
    <property file="local.properties" />
    <property name="lib.dir" location="./lib" />
    <property name="target.dir" location="./target" />
    <property name="epadd.target.dir" location="../epadd/target" /> <!-- default; override in local.properties -->
    <property environment="env" />

    <target name="standalone-jar">
         <!-- this targets updates the standalone jar for both discovery and full. -->


         <!-- Second, add the epadd-setting folder (stored in usr.home folder) -->
         <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar"  update="true" basedir="${user.home}" includes="epadd-settings/**"/>
         <!-- first, add the stuff the launcher needs, like icons etc. (stored in lib.dir) -->
         <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" update="true" basedir="${lib.dir}" includes="index.html,log4j.properties,splash-image.png,muse-icon.png,edu/stanford/ejalbert/launching/windows/windowsConfig.properties"/>

          <!-- make a replica of what we have so far, for discovery -->
          <copy file="${target.dir}/epadd-standalone-jar-with-dependencies.jar" tofile="${target.dir}/epadd-discovery-standalone-jar-with-dependencies.jar"/>

          <!-- add crossdomain.xml only to full epadd-standalone, not to discovery -->
          <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" update="true" basedir="${lib.dir}" includes="crossdomain.xml"/>

          <!-- copy the epadd.war file for both discovery and full into the respective standalone jars. the files have to be named as epadd.war, so copy into java.io.tmpdir first -->
          <copy overwrite="true" file="${epadd.target.dir}/epadd-0.0.1-SNAPSHOT.war" tofile="${java.io.tmpdir}/epadd.war"/>
          <jar update="true" basedir="${java.io.tmpdir}" destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" includes="epadd.war"/>

          <copy overwrite="true" file="${epadd.target.dir}/epadd-discovery-0.0.1-SNAPSHOT.war" tofile="${java.io.tmpdir}/epadd.war"/>
          <jar update="true" basedir="${java.io.tmpdir}" destfile="${target.dir}/epadd-discovery-standalone-jar-with-dependencies.jar" includes="epadd.war"/>

          <!-- rename the files and move them to the current dir -->
          <move file="${target.dir}/epadd-standalone-jar-with-dependencies.jar" tofile="epadd-standalone.jar"/>
          <move file="${target.dir}/epadd-discovery-standalone-jar-with-dependencies.jar" tofile="epadd-discovery-standalone.jar"/>
    </target>

    <target name="standalone-jar-no-discovery"> 
         <!-- target for quick building -->
         <!-- this targets updates the standalone jar for both discovery and full. -->

         
         <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar"  update="true" basedir="${user.home}" includes="epadd-settings/**"/>
         <!-- first, add the stuff the launcher needs, like icons etc. (stored in lib.dir) -->
         <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" update="true" basedir="${lib.dir}" includes="index.html,log4j.properties,splash-image.png,muse-icon.png,edu/stanford/ejalbert/launching/windows/windowsConfig.properties"/>

          <!-- add crossdomain.xml only to full epadd-standalone, not to discovery -->
          <jar destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" update="true" basedir="${lib.dir}" includes="crossdomain.xml"/>

          <!-- copy the epadd.war file for both discovery and full into the respective standalone jars. the files have to be named as epadd.war, so copy into java.io.tmpdir first -->
          <copy overwrite="true" file="${epadd.target.dir}/epadd-0.0.1-SNAPSHOT.war" tofile="${java.io.tmpdir}/epadd.war"/>
          <jar update="true" basedir="${java.io.tmpdir}" destfile="${target.dir}/epadd-standalone-jar-with-dependencies.jar" includes="epadd.war"/>

          <!-- rename the files and move them to the current dir -->
          <move file="${target.dir}/epadd-standalone-jar-with-dependencies.jar" tofile="epadd-standalone.jar"/>
    </target>

	<target name="exe">
		<!-- Ant properties are immutable, so the first matching condition wins. Mac must come before unix. -->
		<condition property="launch4j.dir" value="launch4j-3.50-macos">
		    <os family="mac"/>
		</condition>
		<condition property="launch4j.dir" value="launch4j-3.50-win32">
		    <os family="windows"/>
		</condition>
		<condition property="launch4j.dir" value="launch4j-3.50-linux">
		    <os family="unix"/>
		</condition>
		<taskdef name="launch4j" classname="net.sf.launch4j.ant.Launch4jTask" classpath="${launch4j.dir}/launch4j.jar:${launch4j.dir}/lib/xstream.jar" />
		<launch4j configFile="${launch4j.dir}/epadd.xml" />
	</target>

<!-- Builds epadd.dmg with jpackage. Must run on a Mac. The app runs on the CPU type of the bundled JDK (Apple Silicon or Intel).
     jpackage.jdk: JDK 14 or later that provides the jpackage tool (default: JAVA_HOME)
     runtime.jdk:  JDK 11 or later that is bundled into the app as its Java runtime (default: JAVA_HOME)
     app.version:  version shown in Finder; up to three numbers, the first one greater than 0
     All three can be set in local.properties or with -D. -->
<property name="jpackage.jdk" location="${env.JAVA_HOME}" />
<property name="runtime.jdk" location="${env.JAVA_HOME}" />
<property name="app.version" value="1.0" />

<target name="macapp">
    <fail message="macapp must run on macOS: jpackage can only build a .dmg on a Mac.">
        <condition><not><os family="mac" /></not></condition>
    </fail>
    <fail message="JAVA_HOME is not set. Set it, or set jpackage.jdk and runtime.jdk in local.properties.">
        <condition><or>
            <contains string="${jpackage.jdk}" substring="env.JAVA_HOME" />
            <contains string="${runtime.jdk}" substring="env.JAVA_HOME" />
        </or></condition>
    </fail>
    <fail message="jpackage not found in ${jpackage.jdk}/bin. Set jpackage.jdk to a JDK 14 or later.">
        <condition><not><available file="${jpackage.jdk}/bin/jpackage" /></not></condition>
    </fail>

    <!-- jpackage copies everything in the input folder into the app, so stage only what the app needs -->
    <delete dir="${target.dir}/jpackage" />
    <mkdir dir="${target.dir}/jpackage/input" />
    <copy file="epadd-standalone.jar" todir="${target.dir}/jpackage/input" />
    <copy file="${lib.dir}/splash-image.png" todir="${target.dir}/jpackage/input" />

    <exec executable="${jpackage.jdk}/bin/jpackage" failonerror="true">
        <arg value="--type" />                   <arg value="dmg" />
        <arg value="--name" />                   <arg value="epadd" />
        <arg value="--app-version" />            <arg value="${app.version}" />
        <arg value="--mac-package-identifier" /> <arg value="components.epadd" />
        <arg value="--icon" />                   <arg value="${lib.dir}/epadd.icns" />
        <arg value="--input" />                  <arg value="${target.dir}/jpackage/input" />
        <arg value="--main-jar" />               <arg value="epadd-standalone.jar" />
        <arg value="--main-class" />             <arg value="edu.stanford.epadd.launcher.ePADD" />
        <arg value="--runtime-image" />          <arg value="${runtime.jdk}" />
        <arg value="--java-options" />           <arg value="-XX:MaxRAMPercentage=75" />
        <!-- the jar's SplashScreen-Image is ignored because the app is not started with java -jar -->
        <arg value="--java-options" />           <arg value="-splash:$APPDIR/splash-image.png" />
        <arg value="--dest" />                   <arg value="${target.dir}/jpackage/out" />
    </exec>

    <!-- jpackage names the file epadd-<version>.dmg -->
    <move file="${target.dir}/jpackage/out/epadd-${app.version}.dmg" tofile="epadd.dmg" overwrite="true" />
</target>

<target name="both-mac" depends="macapp"></target>
<target name="both-exe" depends="exe"></target>
<target name="test"><echo message="foobar ${os.name} ${os.version}"/></target>

<target name="release" depends="both-exe,both-mac"></target>

</project>
